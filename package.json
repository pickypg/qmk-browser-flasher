{
  "name": "qmk-browser-flasher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based QMK firmware flasher using WebUSB/WebHID/WebSerial.",
  "engines": {
    "node": ">=24"
  },
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "keywords": [
    "qmk",
    "webusb",
    "webhid",
    "webserial",
    "firmware"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/w3c-web-hid": "^1.0.7",
    "@types/w3c-web-serial": "^1.0.8",
    "@types/w3c-web-usb": "^1.0.14",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
